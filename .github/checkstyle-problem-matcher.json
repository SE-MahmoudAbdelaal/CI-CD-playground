{
  "problemMatcher": [
    {
      "owner": "checkstyle",
      "pattern": [
        {
          "regexp": "^\\[ant:checkstyle\\] \\[ERROR\\] ([^:]+):(\\d+):(?:(\\d+):)? (.+) \\[(\\w+)\\]$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4,
          "code": 5
        }
      ]
    }
  ]
}
